on early-init
    # Configure CPU groups early in the boot process
    # Cluster 0: CPUs 0-3 (Kryo 260 Silver / Efficiency)
    # Cluster 1: CPUs 4-7 (Kryo 260 Gold / Performance)
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/foreground/cpus 0-3,4-7
    write /dev/cpuset/background/cpus 0-2
    write /dev/cpuset/system-background/cpus 0-2
    write /dev/cpuset/restricted/cpus 0-3

on init
    # Enable support for Qualcomm Scheduler
    write /dev/stune/foreground/schedtune.prefer_idle 1
    write /dev/stune/top-app/schedtune.boost 10
    write /dev/stune/top-app/schedtune.prefer_idle 1

on boot
    # Configure Schedutil Governor for the Efficiency Cluster (CPUs 0-3)
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor "schedutil"
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us 20000
    # Minimum idle frequency: 614 MHz (Trinket optimal values)
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 614400

    # Configure Schedutil Governor for the Performance Cluster (CPUs 4-7)
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor "schedutil"
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/down_rate_limit_us 20000
    # Minimum idle frequency for power cluster: 1056 MHz
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 1056000

    # Configure Input Boost optimizer (To avoid lag when touching the screen)
    write /sys/module/cpu_boost/parameters/input_boost_freq "0:1056000 4:1344000"
    write /sys/module/cpu_boost/parameters/input_boost_ms 40

    # Enforce scheduler limits in early user space
    write /sys/devices/system/cpu/cpu_boost/parameters/input_boost_translate_ms 100

on property:sys.boot_completed=1
    # Energy optimization rules after Android complete boot sequence finishes
    # Switch from temporary Performance/Boost mode to smart dynamic power saving
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/pl 1
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/pl 1
    
    # Enable low power states during deep sleep
    write /sys/module/lpm_levels/parameters/sleep_disabled 0

    # Start the platform Power HAL services
    start vendor.power-hal-1-0