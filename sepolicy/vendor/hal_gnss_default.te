# Allow hal_gnss_default to use vendor binder and talk to vndservicemanager
vndbinder_use(hal_gnss_default)
allow hal_gnss_default vndbinder_device:chr_file rw_file_perms;

# Allow hal_gnss_default to read sysfs files for SOC detection
allow hal_gnss_default sysfs_soc:dir r_dir_perms;
allow hal_gnss_default sysfs_soc:file r_file_perms;
allow hal_gnss_default sysfs:file r_file_perms;

# Allow hal_gnss_default to read and write to location sockets and data files
allow hal_gnss_default location_data_file:dir create_dir_perms;
allow hal_gnss_default location_data_file:file create_file_perms;
allow hal_gnss_default location_socket:sock_file create_file_perms;
allow hal_gnss_default location_socket:dir rw_dir_perms;

# Allow hal_gnss_default to access diag device nodes (diagnostics)
userdebug_or_eng(`
  allow hal_gnss_default diag_device:chr_file rw_file_perms;
')

# Allow hal_gnss_default to get/set vendor GPS properties
set_prop(hal_gnss_default, vendor_gps_prop)
